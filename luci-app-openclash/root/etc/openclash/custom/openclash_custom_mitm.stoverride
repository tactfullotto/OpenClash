# 自定义 HTTP(S) 改写，语法与 Stash 覆写 (.stoverride) 一致，优先级高于订阅的覆写
# 仅当本文件包含未注释的内容时才会生效
# 文档：https://stash.wiki
#
# 注意：
#   1. http.script 暂不支持（JavaScript），会被忽略并在日志中提示
#   2. rules 中的策略（如 Proxy）必须存在于当前配置文件中，否则该条规则会被跳过
#   3. 设置了「解密设备」时，rules 只对这些设备生效

#name: 自定义改写
#
#rules:
#  - DOMAIN,ad.example.com,REJECT
#
#http:
#  # 需要解密的主机名，支持 * 和 ? 通配符，"-" 前缀表示排除，":端口" 指定非 443 端口
#  mitm:
#    - "api.example.com"
#    - "*.example.net"
#    - "-static.example.net"
#
#  # URL 改写：正则 替换值 动作（reject / reject-200 / reject-img / reject-dict / reject-array / 302 / 307 / transparent）
#  url-rewrite:
#    - ^https?:\/\/api\.example\.com\/ad - reject-dict
#    - ^https?:\/\/api\.example\.com\/v1\/(.*) https://api.example.com/v2/$1 302
#
#  # Header 改写：request-add / request-del / request-replace / request-replace-regex，response-* 同理
#  header-rewrite:
#    - ^https?:\/\/api\.example\.com request-add X-Client OpenClash
#    - ^https?:\/\/api\.example\.com response-del Set-Cookie
#
#  # Body 改写：request/response-replace-regex 正则 替换值 [正则 替换值 ...]，request/response-jq 'jq 表达式'
#  body-rewrite:
#    - ^https?:\/\/api\.example\.com\/user response-replace-regex '"vip":false' '"vip":true'
#    - ^https?:\/\/api\.example\.com\/feed response-jq 'del(.data.ads)'
